ock a port related to MongoDB, thus needing to be disabled before running.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QUOtNxm2V0"}],"key":"Ic2qrRL05J"}],"visibility":"show","key":"CmRXr8TBIO"},{"type":"block","kind":"notebook-code","data":{"editable":true,"slideshow":{"slide_type":"fragment"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from pymongo.mongo_client import MongoClient\nfrom pymongo.server_api import ServerApi\n\nUSR, PWD = open('../../../No_sync/MongoDB').read().splitlines()\n\nuri = \"mongodb+srv://khliland:\"+PWD+\"@ind320.rhc2o.mongodb.net/?retryWrites=true&w=majority&appName=IND320\"\n\n# Create a new client and connect to the server\nclient = MongoClient(uri, server_api=ServerApi('1'))\n\n# Send a ping to confirm a successful connection\ntry:\n    client.admin.command('ping')\n    print(\"Pinged your deployment. You successfully connected to MongoDB!\")\nexcept Exception as e:\n    print(e)","visibility":"show","key":"eh9LCvGFmc"},{"type":"outputs","id":"oH8sPOPH3XRVMGTk5x-XZ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Pinged your deployment. You successfully connected to MongoDB!\n"},"key":"tO3dm7TpIk"}],"visibility":"show","key":"Twyz6j5PD7"}],"visibility":"show","key":"dQ0xB5lv4L"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"},"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Connecting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g5Hwyw95af"}],"identifier":"connecting","label":"Connecting","html_id":"connecting","implicit":true,"key":"hr0eGsbZiJ"}],"visibility":"show","key":"HTs45eotO2"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-08-17T11:01:34.197554Z","start_time":"2024-08-17T11:01:34.038933Z"},"s